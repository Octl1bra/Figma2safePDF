{
  "name": "figma2safepdf",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin: export frames / slides as image-only PDF and PPTX (flattened, nothing selectable).",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs .smoke-out",
    "harness": "python3 -m http.server 8766"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.139.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1"
  }
}
